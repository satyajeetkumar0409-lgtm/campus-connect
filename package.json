{
  "name": "campus-connect",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @campus-connect/api run dev",
    "dev:web": "npm --workspace @campus-connect/web run dev",
    "build": "npm run build --workspace @campus-connect/api && npm run build --workspace @campus-connect/web",
    "start": "npm --workspace @campus-connect/api run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
